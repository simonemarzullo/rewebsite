# Required. FollowUpBoss personal API key (Admin -> API in FollowUpBoss).
FUB_API_KEY=

# Optional. The lead source name shown in FollowUpBoss for these leads.
FUB_SOURCE=Simone Marzullo Website

# Optional. Only set FUB_SYSTEM_KEY if you complete FollowUpBoss "system
# registration" (see README). If either of these two is missing, requests
# are sent without them -- Basic Auth with FUB_API_KEY is what actually
# authenticates the request.
FUB_SYSTEM=Simone Marzullo Website
FUB_SYSTEM_KEY=

# Email notifications: every lead (including someone who abandons a form
# partway through, subject-tagged "Dropped out") is emailed here in addition
# to being pushed to FollowUpBoss. Required for that feature to work -- if
# SMTP_HOST is unset, email notifications are silently skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=Simone@SimoneMarzullo.com

# Required for the client dashboard (/clientaccess), admin panel (/admin),
# and the off-market buyers/listings (/off-market, /flyer/<id>) it manages.
# POSTGRES_URL is set automatically once you connect a Vercel Postgres
# database to this project (Vercel dashboard -> Storage -> Create Database
# -> Postgres -> Connect to Project) -- you don't need to set it by hand.
# After connecting, run db/schema.sql once against that database (Storage ->
# your database -> Query tab in the Vercel dashboard, or any Postgres client
# using this same URL) to create the tables.
POSTGRES_URL=

# Required. The single password you use to sign in at /admin. Change it
# anytime in Vercel's dashboard (Project Settings -> Environment Variables),
# then redeploy for the new value to take effect.
ADMIN_PASSWORD=

# Required. A long random secret used to sign /clientaccess and /admin session
# cookies (not the same as any password above -- this can't be guessed at,
# so a session can't be forged without it). Generate one with:
#   openssl rand -hex 32
# Rotating this logs everyone (clients and admin) out at once.
SESSION_SECRET=
